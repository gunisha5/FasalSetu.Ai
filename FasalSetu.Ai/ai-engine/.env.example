# ── FasalSetu AI Engine — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in the real values.
# The .env file is git-ignored — never commit secrets.

# Server
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_RELOAD=true

# Google Earth Engine (Phase 3)
# Option A — Service Account (recommended for production)
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=secrets/gee_service_account.json

# GEE Query Windows (days relative to claim_date)
PRE_EVENT_DAYS=30
POST_EVENT_DAYS=15

# Phase 4 Rule Engine Thresholds
FLOOD_NDWI_THRESHOLD=0.3
DROUGHT_NDVI_THRESHOLD=-0.2

# Phase 5 Random Forest Hyperparameters
RF_N_ESTIMATORS=100
RF_TEST_SIZE=0.2
RF_RANDOM_STATE=42

# ── Weather Monitor (OpenWeatherMap) ─────────────────────────────────────────
# Free tier key from https://openweathermap.org/api — 60 calls/min
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_TIMEOUT_SECS=8

# Flood risk: rainfall in last 1 hour >= this value (mm/h) triggers flood signal
WEATHER_FLOOD_RAIN_THRESHOLD_MM=4.0
# Drought risk: humidity at or below this % (combined with near-zero rain)
WEATHER_DROUGHT_HUMIDITY_MAX=25
# Drought: rainfall must be at or below this (mm/h) to flag dry conditions
WEATHER_DROUGHT_RAIN_MAX_MM=0.1

# ── Weighted Confidence Engine ────────────────────────────────────────────────
# Must sum to 1.0. Tune to adjust signal importance.
WEIGHT_HISTORICAL=0.20
WEIGHT_WEATHER=0.25
WEIGHT_SATELLITE=0.35
WEIGHT_ML=0.20
