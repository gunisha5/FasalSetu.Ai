# ── FasalSetu AI Engine — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in the real values.
# The .env file is git-ignored — never commit secrets.

# Server
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_RELOAD=true

# Google Earth Engine (Phase 3)
# Option A — Service Account (recommended for production)
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=secrets/gee_service_account.json

# GEE Query Windows (days relative to claim_date)
PRE_EVENT_DAYS=30
POST_EVENT_DAYS=15

# Phase 4 Rule Engine Thresholds
FLOOD_NDWI_THRESHOLD=0.3
DROUGHT_NDVI_THRESHOLD=-0.2

# Phase 5 Random Forest Hyperparameters
RF_N_ESTIMATORS=100
RF_TEST_SIZE=0.2
RF_RANDOM_STATE=42
